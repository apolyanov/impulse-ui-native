{
  "name": "@impulse-ui-native/modal",
  "version": "7.0.0",
  "description": "Compound modal dialogs with local and OverlayHost lifecycle support.",
  "keywords": [
    "react-native",
    "modal",
    "dialog",
    "components"
  ],
  "license": "MIT",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "types": "dist/index.d.mts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@impulse-ui-native/icon": "workspace:*",
    "@impulse-ui-native/theme": "workspace:*",
    "@impulse-ui-native/primitives": "workspace:*",
    "@impulse-ui-native/core": "workspace:*",
    "@impulse-ui-native/overlay": "workspace:*"
  },
  "devDependencies": {
    "@impulse-ui-native/eslint-config": "workspace:*",
    "@impulse-ui-native/prettier-config": "workspace:*",
    "@impulse-ui-native/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-reanimated": ">=4",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-worklets": ">=0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@impulse-ui-native/prettier-config"
}
