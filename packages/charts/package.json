{
  "name": "@impulse-ui-native/charts",
  "version": "9.0.0",
  "description": "Composable chart components for React Native applications.",
  "keywords": [
    "react-native",
    "charts",
    "data-visualization",
    "skia",
    "components"
  ],
  "license": "MIT",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "types": "dist/index.d.mts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path ../../.prettierignore",
    "test": "node ../../scripts/charts-tests.mjs"
  },
  "dependencies": {
    "@impulse-ui-native/primitives": "workspace:*",
    "@impulse-ui-native/core": "workspace:*",
    "@impulse-ui-native/theme": "workspace:*",
    "d3-array": "catalog:",
    "d3-scale": "catalog:",
    "d3-shape": "catalog:",
    "@impulse-ui-native/card": "workspace:*"
  },
  "devDependencies": {
    "@impulse-ui-native/eslint-config": "workspace:*",
    "@impulse-ui-native/prettier-config": "workspace:*",
    "@impulse-ui-native/tsconfig": "workspace:*",
    "@shopify/react-native-skia": "catalog:",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-native": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5",
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@impulse-ui-native/prettier-config"
}
