{
  "name": "@impulse-ui-native/storybook",
  "version": "2.6.0",
  "description": "Shared Storybook stories and configuration for ImpulseUI Native components.",
  "keywords": [
    "react-native",
    "storybook",
    "components",
    "documentation",
    "impulse-ui-native"
  ],
  "license": "MIT",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "types": "dist/index.d.mts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@impulse-ui-native/icon": "workspace:*",
    "@impulse-ui-native/primitives": "workspace:*",
    "@impulse-ui-native/theme": "workspace:*"
  },
  "devDependencies": {
    "@impulse-ui-native/charts": "workspace:*",
    "@impulse-ui-native/checkbox": "workspace:*",
    "@impulse-ui-native/data-state": "workspace:*",
    "@impulse-ui-native/datetime": "workspace:*",
    "@impulse-ui-native/eslint-config": "workspace:*",
    "@impulse-ui-native/flyout": "workspace:*",
    "@impulse-ui-native/input": "workspace:*",
    "@impulse-ui-native/overlay": "workspace:*",
    "@impulse-ui-native/portal": "workspace:*",
    "@impulse-ui-native/prettier-config": "workspace:*",
    "@impulse-ui-native/radio": "workspace:*",
    "@impulse-ui-native/select": "workspace:*",
    "@impulse-ui-native/skeleton": "workspace:*",
    "@impulse-ui-native/stepper": "workspace:*",
    "@impulse-ui-native/tsconfig": "workspace:*",
    "@shopify/react-native-skia": "catalog:",
    "@storybook/react": "^10.0.0",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-native": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73"
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@impulse-ui-native/prettier-config"
}
