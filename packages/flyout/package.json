{
  "name": "@impulse-ui-native/flyout",
  "version": "16.0.0",
  "description": "Composable, gesture-enabled flyout sheets for React Native applications.",
  "keywords": [
    "react-native",
    "flyout",
    "popover",
    "overlay",
    "components"
  ],
  "license": "MIT",
  "source": "src/index.ts",
  "module": "dist/index.js",
  "types": "dist/index.d.mts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm exec eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path ../../.prettierignore",
    "test": "node --test ../../scripts/flyout-keyboard-tests.mjs ../../scripts/flyout-lifecycle-tests.mjs ../../scripts/flyout-render-tests.mjs"
  },
  "dependencies": {
    "@impulse-ui-native/theme": "workspace:*",
    "@impulse-ui-native/overlay": "workspace:*",
    "@impulse-ui-native/primitives": "workspace:*",
    "@impulse-ui-native/core": "workspace:*"
  },
  "devDependencies": {
    "@impulse-ui-native/eslint-config": "workspace:*",
    "@impulse-ui-native/prettier-config": "workspace:*",
    "@impulse-ui-native/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-worklets": "catalog:",
    "typescript": "catalog:",
    "react-native-keyboard-controller": "catalog:",
    "react-reconciler": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-reanimated": ">=4.0.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-worklets": ">=0.5",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-keyboard-controller": ">=1.22.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "react-native": "./dist/index.js",
        "import": "./dist/index.js"
      }
    }
  },
  "prettier": "@impulse-ui-native/prettier-config"
}
