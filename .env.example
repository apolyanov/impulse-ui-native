# Public hostname routed to this site. Its DNS record must point to Traefik.
SITE_HOST=ui.example.com

# Existing external Docker network shared with the Traefik container.
TRAEFIK_NETWORK=proxy

# Names configured in Traefik's static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
