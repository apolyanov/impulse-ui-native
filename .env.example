# Public hostname routed to this site. Its DNS record must point to Traefik.
SITE_HOST=ui.example.com

# Email used by Let's Encrypt for expiry and account notices.
TRAEFIK_ACME_EMAIL=admin@example.com

# Docker network created for Traefik and the site.
TRAEFIK_NETWORK=proxy

# Optional search-engine ownership tokens. Leave blank until configured.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
